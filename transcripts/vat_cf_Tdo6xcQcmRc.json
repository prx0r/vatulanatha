  {
   "t": 307.5,
   "end": 308.34,
   "text": "is projected."
  },
  {
   "t": 310.7,
   "end": 311.34,
   "text": "Paiyotara,"
  },
  {
   "t": 311.8,
   "end": 313.12,
   "text": "the support of milk,"
