   "end": 304.62,
   "text": "is like a plain wall"
  },
  {
   "t": 304.62,
   "end": 305.58,
   "text": "on which the universe,"
  },
  {
   "t": 305.82,
   "end": 307.5,
   "text": "the image of the whole universe"
