  },
  {
   "t": 117.28,
   "end": 120.66,
   "text": "where there is no room for any other agency."
  },
  {
   "t": 121.6,
   "end": 123.48,
   "text": "Translation of Niravakasha."
  },
  {
   "t": 124.52,
   "end": 127.84,
   "text": "We have already seen that the language of tantra,"
  },
  {
   "t": 128.12,
   "end": 129.74,
   "text": "and specifically karma,"
  },
  {
   "t": 130.5,
   "end": 134.16,
   "text": "uses words taken from the domain of food and eating."
  },
  {
   "t": 134.16,
   "end": 137.7,
   "text": "Grasa is often used to indicate"
  },
  {
   "t": 137.7,
   "end": 140.96,
   "text": "the absorption, devouring, swallowing,"
  },
  {
   "t": 141.48,
   "end": 145.22,
   "text": "thus integrating and hence eliminating something,"
